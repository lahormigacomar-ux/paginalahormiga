# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE POSTGRESQL DATABASE CONNECTION
# Obtenida en Supabase -> Project Settings -> Database -> Connection String (URI)
# Ejemplo: postgresql://postgres:[PASSWORD]@db.byqzxlrbggdnzvvoigge.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:[TU_CONTRASEÑA]@db.byqzxlrbggdnzvvoigge.supabase.co:5432/postgres"
# O bien puedes pasar solo la contraseña de la BD:
SUPABASE_DB_PASSWORD=""

# SUPABASE CLIENT CREDENTIALS
SUPABASE_URL="https://byqzxlrbggdnzvvoigge.supabase.co"
